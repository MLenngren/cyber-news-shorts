# Copy to .env and fill in values.
# Secrets are env-first. Optional `op://` reads only happen when OP_SERVICE_ACCOUNT_TOKEN is set.

# --- Brand / identity (non-secret) ---
BRAND_NAME="ThreatNoir Cyber News"
BRAND_SHORT_NAME="ThreatNoir"
BRAND_URL="https://threatnoir.com"
# Used by scripts/publish_youtube.py when present
BRAND_HASHTAGS="#cybersecurity #infosec"
# BRAND_USER_AGENT="ThreatNoirCyberNews/0.1 (+https://threatnoir.com)"
# Used by scripts/discord_notify.py when present
DISCORD_USER_AGENT="ThreatNoirCyberNews/0.1 (+https://threatnoir.com)"

# Optional: used by the cron example as a news source hint.
NEWS_BRIEF_URL=""

# Empty by default (OSS-safe). If set, some scripts may send best-effort DMs.
OPERATOR_DISCORD_ID=""

# Default mode override for scripts/render_short.py
# THREATNOIR_MODE="talking-head"

# Default edition override (sugar over mode + the on-screen brief badge):
#   morning -> stock-broll (no avatar) ; evening -> talking-head-hybrid (HeyGen avatar)
# THREATNOIR_EDITION="evening"

# --- Talking-head / evening avatar + voice config ---
# Avatar precedence: script frontmatter `heygen_avatar_id` > this env > operator file.
# Any public HeyGen avatar id works out of the box.
HEYGEN_AVATAR_ID="Tyler-incasualsuit-20220721"
# Voice precedence: script frontmatter `elevenlabs_voice_id` > this env.
ELEVENLABS_VOICE_ID="7S3KNdLDL7aRgBVRQb1z"
# Optional: a pre-uploaded HeyGen background asset id. Leave empty to render the
# avatar on a solid-color background (no asset upload needed — the OSS default).
HEYGEN_BG_ASSET_ID=""
# HEYGEN_BG_TYPE="video"   # set to image/video to match your uploaded bg asset

# Cron example: opt-in publishing toggle (default off)
THREATNOIR_PUBLISH="0"

# --- Secrets / API keys ---
ELEVENLABS_API_KEY=""
HEYGEN_API_KEY=""
PEXELS_API_KEY=""
STORYBLOCKS_PUBLIC_API_KEY=""
STORYBLOCKS_PRIVATE_API_KEY=""
RUNWARE_API_KEY=""
OPENROUTER_API_KEY=""

# Optional integrations
DISCORD_BOT_TOKEN=""
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
YOUTUBE_REFRESH_TOKEN=""
DECART_API_KEY=""

# Optional: allow op:// secret reads via 1Password service account
OP_SERVICE_ACCOUNT_TOKEN=""
