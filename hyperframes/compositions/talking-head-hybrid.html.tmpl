<!-- SOURCE OF TRUTH.
     Render-time values are injected by scripts/modes/talking_head_hybrid.py from this .tmpl.
     The sibling talking-head-hybrid.html is derived — edit this file, not the .html. -->
<!-- VISUAL HIERARCHY CONTRACT (v3.3 — 2026-05-24)
     At any moment, exactly ONE element leads:
     - t=0 to opener_end:            OPENER POSTER leads, Tyler full-bleed background
     - opener_end to SUBTITLE_END:   TYLER in PIP + ambient bg + cutaways + RGB caption stack
                                     (subtitles auto-segment on ≥0.25s gaps, words voice-synced)
     - SUBTITLE_END to CLIMAX_START: TYLER full-bleed (no subs, no climax — clean breathing room)
     - CLIMAX_START to audio_end:    TYLER full-bleed + CLIMAX glitch text (RGB word stack)
     - audio_end to TOTAL_DURATION:  silent tail; climax holds + end card slides in

	     Z-INDEX:
	     ambient-bg=1 < cutaways=5 < Tyler=10 < captions=15 < flash-bullets=30 < climax=24 < end-card=12 -->
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=1080, height=1920" />
  <script src="https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js"></script>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    html, body {
      width: 1080px; height: 1920px;
      overflow: hidden; background: #04060A;
      font-family: "Inter", system-ui, sans-serif;
      color: #F4F1EA;
      -webkit-font-smoothing: antialiased;
    }
    #root { position: relative; width: 100%; height: 100%; background: #04060A; }

    .avatar-video {
      position: absolute;
	      top: 0; left: 0;
      width: 1080px; height: 1920px;
      object-fit: cover;
		      z-index: 10;
	      will-change: transform;
    }

	    .ambient-bg-video {
	      position: absolute;
	      top: 0; left: 0;
	      width: 1080px; height: 1920px;
	      object-fit: cover;
	      opacity: 0;
	      z-index: 1;
	      filter: blur(2px) brightness(0.5) saturate(0.7);
	      will-change: opacity;
	    }

	    .cutaway-video {
	      position: absolute;
	      top: 0;
	      left: 0;
	      width: 1080px;
	      height: 1920px;
	      object-fit: cover;
	      opacity: 0;
	      z-index: 5;
	      will-change: opacity;
	    }

    .top-gradient {
      position: absolute; top: 0; left: 0; right: 0;
      height: 240px;
      background: linear-gradient(180deg, rgba(4,6,10,0.85) 0%, rgba(4,6,10,0.55) 50%, transparent 100%);
      z-index: 10;
      pointer-events: none;
    }
    .live-badge {
      position: absolute;
      top: 36px; left: 40px;
      display: flex; align-items: center; gap: 10px;
      font-family: "JetBrains Mono", monospace;
      font-size: 18px; letter-spacing: 0.18em;
      font-weight: 700;
      color: #FF3355;
      z-index: 20;
    }
    .live-badge .led {
      width: 12px; height: 12px; border-radius: 50%;
      background: #FF3355; box-shadow: 0 0 16px #FF3355;
    }
    .timestamp {
      position: absolute;
      top: 78px; left: 40px;
      font-family: "JetBrains Mono", monospace;
      font-size: 13px; letter-spacing: 0.16em;
      color: #8C9296;
      z-index: 20;
    }
    .show-id {
      position: absolute;
      top: 38px; right: 40px;
      font-family: "JetBrains Mono", monospace;
      font-size: 16px; letter-spacing: 0.20em;
      color: #C0C7CB;
      z-index: 20;
      text-align: right;
    }
    .show-id .accent { color: #5BB7E0; }

    .scanlines {
      position: absolute; inset: 0;
      pointer-events: none;
      background-image: repeating-linear-gradient(
        0deg,
        rgba(255,255,255,0.025) 0px,
        rgba(255,255,255,0.025) 1px,
        transparent 1px,
        transparent 4px
      );
      mix-blend-mode: overlay;
      z-index: 9;
    }

    .floater {
      position: absolute;
      z-index: 15;
      opacity: 0;
    }

	    .opener-poster {
	      position: absolute;
	      top: 50%; left: 50%;
	      width: 920px;
	      text-align: center;
	      font-family: "Space Grotesk", sans-serif;
	      font-weight: 900;
	      font-size: 140px;
	      line-height: 0.92;
	      color: #F4F1EA;
	      letter-spacing: -0.03em;
	      text-transform: uppercase;
	      text-shadow: 0 0 40px rgba(255, 51, 85, 0.4);
	      opacity: 0;
	      z-index: 24;
	    }
	    .opener-poster .accent { color: #FF3355; }

    /* Top-left tag — MORNING brief = cool blue border */
    .story-tag {
      top: 156px; left: 40px;
      font-family: "Space Grotesk", sans-serif;
      font-weight: 900; font-size: 26px;
      color: #5BB7E0;
      background: rgba(91,183,224,0.12);
      border: 2px solid #5BB7E0;
      padding: 8px 22px;
      letter-spacing: 0.20em;
      box-shadow: 0 0 30px rgba(91,183,224,0.3);
    }
    .story-tag.red {
      color: #FF3355;
      background: rgba(255,51,85,0.12);
      border-color: #FF3355;
      box-shadow: 0 0 30px rgba(255,51,85,0.3);
    }
    .story-tag.warm {
      color: #F2B855;
      background: rgba(242,184,85,0.12);
      border-color: #F2B855;
      box-shadow: 0 0 30px rgba(242,184,85,0.3);
    }

		    .caption-stack {
		      position: absolute;
			      top: 25%;
		      left: 50%;
		      transform: translateX(-50%);
		      width: 920px;
		      display: flex;
		      flex-direction: column;
		      align-items: center;
		      gap: 14px;
		      z-index: 15;
		      pointer-events: none;
		    }
		    .line-row {
		      position: relative;
		      display: flex;
		      flex-wrap: wrap;
		      justify-content: center;
		      gap: 18px 22px;
		      width: 100%;
		    }
		    .word-row {
		      position: relative;
		      display: inline-flex;
		      justify-content: center;
		      align-items: center;
		      opacity: 0;
		      line-height: 0.95;
		      letter-spacing: -0.02em;
		    }
		    .word-row .layer {
		      font-family: "Space Grotesk", sans-serif;
		      font-weight: 900;
		      font-size: 78px;
		      letter-spacing: -0.02em;
		      white-space: nowrap;
		      text-transform: uppercase;
		    }
		    .word-row .layer.r,
		    .word-row .layer.c {
		      position: absolute;
		      top: 0; left: 50%;
		      transform: translateX(-50%);
		      opacity: 0.85;
		      mix-blend-mode: screen;
		      pointer-events: none;
		    }
		    .word-row .layer.main { color: #F4F1EA; text-shadow: 0 2px 18px rgba(0,0,0,0.55); }
		    .word-row .layer.r    { color: #FF3355; }
		    .word-row .layer.c    { color: #5BB7E0; }
		    .word-row mark.hl {
		      background: rgba(245, 212, 66, 0.96);
		      color: #04060A;
		      padding: 2px 12px;
		      border-radius: 6px;
		      font-weight: 900;
		      box-decoration-break: clone;
		      -webkit-box-decoration-break: clone;
		    }

    /* Bottom ticker — morning cool edition */
    .ticker {
      position: absolute;
      bottom: 0; left: 0; right: 0;
      height: 60px;
      background: linear-gradient(90deg, rgba(8,18,28,0.95), rgba(91,183,224,0.18));
      border-top: 2px solid rgba(91,183,224,0.55);
      box-shadow: 0 -2px 16px rgba(91,183,224,0.18);
      display: flex; align-items: center;
      overflow: hidden;
      z-index: 25;
    }
    .ticker .strip {
      display: flex; gap: 70px;
      white-space: nowrap;
      font-family: "JetBrains Mono", monospace;
      font-size: 18px; letter-spacing: 0.14em;
      color: #C0C7CB;
      will-change: transform;
    }
    .ticker .strip .item .v { color: #5BB7E0; }
    .ticker .strip .item .red { color: #FF3355; }
    .ticker .strip .item .warm { color: #F2B855; }
    .ticker .strip .item .magenta { color: #C458DC; }
    .ticker .strip .item .cool { color: #5BB7E0; }

    /* End card */
    .end-card {
      position: absolute;
      inset: 0;
      background: rgba(4, 6, 10, 0.97);
      display: flex; flex-direction: column;
      align-items: center; justify-content: center;
      z-index: 100;
      opacity: 0;
    }
    .end-card .show {
      font-family: "Space Grotesk", sans-serif;
      font-weight: 800; font-size: 84px;
      letter-spacing: -0.02em; color: #F4F1EA; line-height: 1.0;
      text-align: center;
    }
    .end-card .show .slash { color: #5BB7E0; margin: 0 10px; }
    .end-card .tagline {
      font-family: "JetBrains Mono", monospace;
      font-size: 26px; letter-spacing: 0.14em;
      color: #C0C7CB; margin-top: 36px; text-align: center; padding: 0 60px; line-height: 1.5;
    }
    .end-card .tagline .accent { color: #5BB7E0; }
    .end-card .tagline .red { color: #FF3355; }
    .end-card .tagline .warm { color: #F2B855; }
    .end-card .source {
      font-family: "JetBrains Mono", monospace;
      font-size: 14px; letter-spacing: 0.20em;
      color: #4D5C61; margin-top: 56px;
    }

	    .flash-bullet {
	      position: absolute;
	      top: 50%; left: 50%;
	      padding: 28px 48px;
	      background: rgba(0, 0, 0, 0.82);
	      backdrop-filter: blur(6px);
	      border-radius: 10px;
	      border-left: 4px solid #FF3355;
	      text-align: center;
	      font-family: "Space Grotesk", sans-serif;
	      font-weight: 900;
	      color: #F4F1EA;
	      letter-spacing: -0.02em;
	      opacity: 0;
	      z-index: 30;
	      white-space: nowrap;
	    }
    .flash-bullet .main { font-size: 120px; line-height: 1.0; }
    .flash-bullet .sub {
      font-size: 36px;
      color: #C0C7CB;
      margin-top: 12px;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }

	    .climax-glitch {
	      position: absolute;
	      top: 30%; left: 50%;
	      transform: translate(-50%, 0);
	      width: 920px;
	      display: flex;
	      flex-direction: column;
	      align-items: center;
	      gap: 12px;
	      font-family: "Space Grotesk", sans-serif;
	      font-weight: 900;
	      color: #F4F1EA;
	      letter-spacing: -0.03em;
	      opacity: 0;
	      z-index: 24;
	      text-shadow: 0 0 30px rgba(91, 183, 224, 0.4);
	    }
	    .climax-glitch .word { font-size: 88px; line-height: 0.95; text-align: center; }

	    .climax-glitch-r, .climax-glitch-c {
	      position: absolute; top: 30%; left: 50%; transform: translate(-50%, 0);
	      width: 920px;
	      display: flex; flex-direction: column; align-items: center; gap: 12px;
	      font-family: "Space Grotesk", sans-serif;
	      font-weight: 900;
	      letter-spacing: -0.03em;
	      opacity: 0;
	      mix-blend-mode: screen;
	      pointer-events: none;
	      z-index: 24;
	    }
	    .climax-glitch-r .word, .climax-glitch-c .word { font-size: 88px; line-height: 0.95; text-align: center; }
	    .climax-glitch-r { color: #FF3355; }
	    .climax-glitch-c { color: #5BB7E0; }
  </style>
</head>
<body>
	  <div id="root" data-composition-id="main"
	       data-start="0" data-duration="{{TOTAL_DURATION}}"
       data-width="1080" data-height="1920">

    <!-- Master audio (HeyGen-synced) -->
	    <audio id="master" class="clip"
	           data-start="0" data-duration="{{AVATAR_DURATION}}"
           data-track-index="50"
           src="master.wav" data-volume="1"></audio>

	    <video id="ambient-bg"
	           class="clip ambient-bg-video"
	           data-start="{{PIP_START_TIME}}"
	           data-duration="{{AMBIENT_DURATION}}"
	           data-track-index="0"
	           src="{{AMBIENT_SRC}}"
	           style="{{AMBIENT_DISPLAY}}"
	           muted playsinline loop></video>

    <!-- Full-screen Tyler avatar -->
	    <video id="avatar" class="clip avatar-video"
	           data-start="0" data-duration="{{AVATAR_DURATION}}" data-track-index="1"
           src="avatar.mp4" muted playsinline></video>

	    <!-- Cutaways (b-roll) (written by scripts/modes/talking_head_hybrid.py). -->
	    <!-- CUTAWAYS_INSERT_HERE -->

    <div class="scanlines"></div>

    <!-- Top chrome -->
    <div class="top-gradient"></div>
    <div class="live-badge"><span class="led" id="live-led"></span>LIVE</div>
    <div class="timestamp" id="timestamp">CYBER WIRE · 06:00 UTC</div>
    <div class="show-id">THREATNOIR<br><span class="accent">// CYBER NEWS</span></div>

    <!-- Story tags (top-left) — track 5 (morning brief = cool blue) -->
	    <div id="tag-morning" class="clip floater story-tag"
	         data-start="0.3" data-duration="3.70" data-track-index="10">▌ {{EDITION_BADGE_TEXT}}</div>
	    <div id="tag-story1" class="clip floater story-tag red"
	         data-start="{{CHYRON_1_START}}" data-duration="{{CHYRON_1_DURATION}}" data-track-index="10">▌ {{CHYRON_1_TEXT}}</div>
	    <div id="tag-story2" class="clip floater story-tag warm"
	         data-start="{{CHYRON_2_START}}" data-duration="{{CHYRON_2_DURATION}}" data-track-index="10">▌ {{CHYRON_2_TEXT}}</div>
	    <div id="tag-story3" class="clip floater story-tag red"
	         data-start="{{CHYRON_3_START}}" data-duration="{{CHYRON_3_DURATION}}" data-track-index="10">▌ {{CHYRON_3_TEXT}}</div>

    <!-- ============ Track 3: full-screen overlays ============ -->

	    <div id="opener-poster" class="clip opener-poster floater"
	         data-start="0.5" data-duration="{{OPENER_DURATION}}"
	         data-track-index="3" style="{{OPENER_DISPLAY}}">{{OPENER_TEXT_HTML}}</div>

    <!-- Flash bullets (written by scripts/modes/talking_head_hybrid.py). -->
    <!-- FLASH_BULLETS_INSERT_HERE -->

	    <!-- Climax GLITCH (render-time punchline) -->
	    <div id="climax-glitch" class="clip climax-glitch floater"
	         data-start="{{CLIMAX_START}}" data-duration="{{CLIMAX_DURATION}}" data-track-index="24">
	      {{CLIMAX_WORDS_HTML}}
	    </div>
	    <div id="climax-glitch-r" class="climax-glitch-r">{{CLIMAX_WORDS_HTML}}</div>
	    <div id="climax-glitch-c" class="climax-glitch-c">{{CLIMAX_WORDS_HTML}}</div>


	    <div class="caption-stack" id="captionStack"></div>

    <!-- Bottom ticker -->
    <div class="ticker">
	      <div class="strip" id="ticker-strip">
	        {{TICKER_ITEMS_HTML}}
	      </div>
    </div>

    <!-- End card (track 6) -->
	    <div id="end-card" class="clip end-card"
	         data-start="{{ENDCARD_START}}" data-duration="{{ENDCARD_DURATION}}" data-track-index="12">
      <div class="show">THREATNOIR<span class="slash">//</span>CYBER NEWS</div>
	      <div class="tagline">{{STORY_HEADLINE}}</div>
	      <div class="source">SOURCES &middot; THREATNOIR {{EDITION_BADGE_TEXT}} &middot; {{STORY_DATE_ISO}}</div>
    </div>

  </div>

  <script>
    window.__timelines = window.__timelines || {};
	    window.__CUTAWAYS__ = {{CUTAWAYS_JSON}};
		    window.__FLASH_BULLETS__ = {{FLASH_BULLETS_JSON}};
    const tl = gsap.timeline({ paused: true });

		    // Avatar PIP layout (bottom-right). Used once early, then once back to full.
	    tl.set("#avatar", { transformOrigin: "top left", x: 0, y: 0, scale: 1 }, 0);
	    const PIP = {
	      scale: 0.25,
	      x: 1080 - 60 - 1080 * 0.25,
	      y: 1920 - 60 - 1920 * 0.25
	    };
		    const PIP_START_TIME = Number({{PIP_START_TIME}});
		    const PIP_END_TIME = Number({{PIP_END_TIME}});
		    if (
		      Number.isFinite(PIP_START_TIME) &&
		      Number.isFinite(PIP_END_TIME) &&
		      PIP_START_TIME >= 0 &&
		      PIP_END_TIME > PIP_START_TIME
		    ) {
		      tl.to(
		        "#avatar",
		        { ...PIP, duration: 0.5, ease: "power2.out", overwrite: "auto" },
		        PIP_START_TIME
		      );
		      tl.to(
		        "#avatar",
		        { x: 0, y: 0, scale: 1, duration: 0.5, ease: "power2.out", overwrite: "auto" },
		        PIP_END_TIME
		      );

		      const ambientEl = document.querySelector("#ambient-bg");
		      if (ambientEl && ambientEl.style.display !== "none") {
		        tl.to(
		          "#ambient-bg",
		          { opacity: 0.35, duration: 0.6, ease: "power2.out", overwrite: "auto" },
		          PIP_START_TIME
		        );
		        tl.to(
		          "#ambient-bg",
		          { opacity: 0.0, duration: 0.4, ease: "power2.in", overwrite: "auto" },
		          PIP_END_TIME
		        );
		      }
		    }

		    // Per-word timing from Whisper transcript.json
		    const WORDS = <!-- LINES_INSERT_HERE -->;
		    const HIGHLIGHT_WORDS = new Set(<!-- HIGHLIGHTS_INSERT_HERE -->);

		    const SUBTITLE_START_SEC = {{SUBTITLE_START}};
		    const SUBTITLE_END_SEC   = {{SUBTITLE_END}};
		    const LINE_GAP_SEC = 0.25;
		    const WORD_IN_DUR = 0.18, RESOLVE_DELAY = 0.20, RESOLVE_DUR = 0.28;
		    const FRINGE_PUSH = 6, FRINGE_IN = 28;
			    const LINE_EXIT_DUR = 0.30;

			    const LINES_PER_PARAGRAPH = 2;

			    const stack = document.getElementById("captionStack");

			    // Pre-compute end times for gap detection
			    WORDS.forEach(w => { w.end_ = (typeof w.end === "number" ? w.end : (w.start + 0.3)); });

			    // Segment words into lines by ≥LINE_GAP_SEC pause gap
			    function segmentLines(words) {
			      const lines = []; let cur = [];
			      for (let i = 0; i < words.length; i++) {
			        if (cur.length === 0) cur.push(i);
			        else {
			          const gap = words[i].start - words[cur[cur.length-1]].end_;
			          if (gap > LINE_GAP_SEC) { lines.push(cur); cur = [i]; }
			          else cur.push(i);
			        }
			      }
			      if (cur.length) lines.push(cur);
			      return lines;
			    }
			    const LINES = segmentLines(WORDS);
			    const lineEls = new Array(LINES.length).fill(null);

			    // Build a word element (3 RGB layers + optional yellow highlight)
			    function buildWord(text, allowHighlight) {
			      const upper = String(text).toUpperCase();
			      // Case-insensitive match: producer brackets are uppercased, Whisper words
			      // are mixed-case. Set is lowercased server-side; lowercase here too.
			      const bare = String(text).toLowerCase().replace(/[.,;:!?"']+$/g, "");
			      const isHL = allowHighlight && HIGHLIGHT_WORDS.has(bare);
			      const html = isHL ? `<mark class="hl">${upper}</mark>` : upper;
			      const row = document.createElement("span");
			      row.className = "word-row";
			      row.style.opacity = 0;
			      row.innerHTML = `
			        <span class="layer r">${html}</span>
			        <span class="layer c">${html}</span>
			        <span class="layer main">${html}</span>
			      `;
			      return row;
			    }

			    // Pre-create all line containers + word elements at page load.
			    // Each line is a <div class="line-row"> with its words appended.
			    // All animations placed on the master timeline `tl` at absolute timestamps —
			    // HyperFrames seeks per-frame and GSAP applies correct state.
			    LINES.forEach((lineIdxs, lineIdx) => {
			      const lineEl = document.createElement("div");
			      lineEl.className = "line-row";
			      lineEl.style.opacity = 1;
			      lineEls[lineIdx] = lineEl;
			      stack.appendChild(lineEl);

			      const firstWord = WORDS[lineIdxs[0]];
			      const lineStart = firstWord.start;
			      const nextLineStart = (lineIdx + 1 < LINES.length)
			        ? WORDS[LINES[lineIdx + 1][0]].start
			        : SUBTITLE_END_SEC;

			      // Skip lines outside the subtitle window entirely
			      if (lineStart >= SUBTITLE_END_SEC || nextLineStart <= SUBTITLE_START_SEC) {
			        lineEl.style.display = "none";
			        return;
			      }

			      // Build word elements + place their entry/resolve tweens on `tl`.
			      // Cap: at most ONE yellow highlight per logical line — only the first
			      // power-word match in each line gets the mark. Reduces visual noise.
			      let lineHadHighlight = false;
			      lineIdxs.forEach((wi) => {
			        const w = WORDS[wi];
			        if (w.start < SUBTITLE_START_SEC || w.start >= SUBTITLE_END_SEC) return;
			        const bareForHL = String(w.word).toLowerCase().replace(/[.,;:!?"']+$/g, "");
			        const eligibleHL = !lineHadHighlight && HIGHLIGHT_WORDS.has(bareForHL);
			        if (eligibleHL) lineHadHighlight = true;
			        const el = buildWord(w.word, eligibleHL);
			        lineEl.appendChild(el);
			        const rL = el.querySelector(".layer.r");
			        const cL = el.querySelector(".layer.c");

			        // Entry: opacity + scale + RGB chroma drift
			        tl.fromTo(el,
			          { opacity: 0, scale: 0.88 },
			          { opacity: 1, scale: 1.0, duration: WORD_IN_DUR, ease: "power3.out", overwrite: "auto" },
			          w.start);
			        tl.fromTo(rL,
			          { x: -FRINGE_IN, opacity: 0.85 },
			          { x: -FRINGE_PUSH, duration: WORD_IN_DUR, ease: "power2.out", overwrite: "auto" },
			          w.start);
			        tl.fromTo(cL,
			          { x: FRINGE_IN, opacity: 0.85 },
			          { x: FRINGE_PUSH, duration: WORD_IN_DUR, ease: "power2.out", overwrite: "auto" },
			          w.start);
			        // Glitch pulse
			        tl.to(el,
			          { scale: 1.05, duration: 0.08, yoyo: true, repeat: 1, ease: "power2.inOut", overwrite: "auto" },
			          w.start + WORD_IN_DUR + 0.02);
			        // Resolve: RGB layers fade out to clean white text
			        tl.to([rL, cL],
			          { x: 0, opacity: 0, duration: RESOLVE_DUR, ease: "power2.inOut", overwrite: "auto" },
			          w.start + WORD_IN_DUR + RESOLVE_DELAY);
			      });

			    });

			    // Paragraph scroll-up: every LINES_PER_PARAGRAPH lines, fade+slide-up the whole paragraph
			    // together so new lines start fresh at the top of the stack.
			    const PARAGRAPH_EXIT_DUR = 0.45;
			    const PARAGRAPH_EXIT_Y = -120;  // larger slide-up than per-line exit

			    for (let p = 0; p < LINES.length; p += LINES_PER_PARAGRAPH) {
			      const pEnd = Math.min(p + LINES_PER_PARAGRAPH, LINES.length);
			      const lastLineIdxs = LINES[pEnd - 1];
			      const lastWordInPara = WORDS[lastLineIdxs[lastLineIdxs.length - 1]];
			      const paraEndTime = lastWordInPara.end_;

			      let exitAt;
			      if (pEnd < LINES.length) {
			        const nextParaFirstWord = WORDS[LINES[pEnd][0]];
			        exitAt = Math.max(paraEndTime + 0.3, nextParaFirstWord.start - PARAGRAPH_EXIT_DUR - 0.05);
			      } else {
			        exitAt = Math.min(paraEndTime + 0.5, SUBTITLE_END_SEC - PARAGRAPH_EXIT_DUR);
			      }

			      // Fade + slide-up all lines in this paragraph; collapse layout via display:none
			      for (let li = p; li < pEnd; li++) {
			        const el = lineEls[li];
			        if (!el) continue;
			        tl.to(el,
			          {
			            opacity: 0,
			            y: PARAGRAPH_EXIT_Y,
			            duration: PARAGRAPH_EXIT_DUR,
			            ease: "power2.in",
			            overwrite: "auto",
			            onComplete: () => { el.style.display = "none"; },
			          },
			          exitAt);
			      }
			    }

	    /* Cutaways timeline (written by scripts/modes/talking_head_hybrid.py). */
	    (function bindCutaways() {
	      const raw = window.__CUTAWAYS__;
	      const cuts = Array.isArray(raw) ? raw.slice() : [];
	      cuts.sort((a, b) => Number(a?.start || 0) - Number(b?.start || 0));
	      if (!cuts.length) return;

	      for (let i = 0; i < cuts.length; i++) {
	        const c = cuts[i] || {};
	        const start = Number(c.start || 0);
	        const duration = Math.max(0, Number(c.duration || 0));
	        const end = start + duration;
	        const next = i + 1 < cuts.length ? (cuts[i + 1] || {}) : null;
	        const nextStart = next ? Number(next.start || 0) : null;
	        const nearNext = nextStart !== null && (nextStart - end) < 1.0;
	
	        const tIn = Math.max(0, start - 0.2);
	        const tOut = Math.max(0, (nearNext ? nextStart : end) - 0.2);
	
	        const id = "#cutaway-" + String(i);
	        const nextId = "#cutaway-" + String(i + 1);

		        // Cutaway fade in/out only. Avatar sizing is controlled by the global PIP rhythm above.
	        tl.to(id, { opacity: 1, duration: 0.4, ease: "power2.inOut", overwrite: "auto" }, tIn);

	        if (nearNext) {
	          // Crossfade to the next cutaway and stay in PIP.
	          tl.to(id, { opacity: 0, duration: 0.4, ease: "power2.inOut", overwrite: "auto" }, tOut);
	          tl.to(nextId, { opacity: 1, duration: 0.4, ease: "power2.inOut", overwrite: "auto" }, tOut);
	        } else {
	          // Exit PIP + fade out cutaway.
	          tl.to(id, { opacity: 0, duration: 0.4, ease: "power2.inOut", overwrite: "auto" }, tOut);
	        }
	      }
	    })();

		    /* Flash bullets timeline (written by scripts/modes/talking_head_hybrid.py). */
		    (function bindFlashBullets() {
		      const raw = window.__FLASH_BULLETS__;
		      const bullets = Array.isArray(raw) ? raw.slice() : [];
		      if (!bullets.length) return;
		
		      for (let i = 0; i < bullets.length; i++) {
		        const b = bullets[i] || {};
		        const at = Number(b.at_sec ?? 0);
		        if (!Number.isFinite(at) || at < 0) continue;
		        const id = "#flash-" + String(i);
		        if (!document.querySelector(id)) continue;
		
		        tl.set(id, { xPercent: -50, yPercent: -50, scale: 0.92 }, 0);
		        tl.fromTo(
		          id,
		          { opacity: 0 },
		          { opacity: 1, scale: 1.0, duration: 0.2, ease: "back.out(2)", overwrite: "auto" },
		          at
		        );
		        tl.to(id, { opacity: 0, duration: 0.3, ease: "power2.in", overwrite: "auto" }, at + 2.0);
		      }
		    })();

    /* LIVE LED throb */
    tl.to("#live-led", { opacity: 0.4, duration: 0.7, ease: "sine.inOut", yoyo: true, repeat: 100 }, 0);

	    const TOTAL = Number(document.querySelector("#root")?.dataset?.duration || 0);
	
	    /* Ticker scroll — finite (capture-safe) and bounded by composition duration */
	    tl.fromTo(
	      "#ticker-strip",
	      { x: 0 },
	      { x: -4200, duration: Math.max(8, TOTAL * 0.95), ease: "none" },
	      0
	    );

	    /* Timestamp tick (bounded by composition duration) */
    const ts = { sec: 0 };
    tl.to(ts, {
	      sec: TOTAL, duration: TOTAL, ease: "none",
      onUpdate: function() {
        const total = Math.floor(ts.sec);
        const m = String(Math.floor(total / 60)).padStart(2, "0");
        const s = String(total % 60).padStart(2, "0");
        const el = document.querySelector("#timestamp");
        if (el) el.innerText = "CYBER WIRE · 06:" + m + ":" + s + " UTC";
      }
    }, 0);

	    /* === Story tags fade-in/out (schedule from clip data attrs) === */
	    function _numAttr(el, name, fallback) {
	      if (!el) return fallback;
	      const v = Number(el.dataset ? el.dataset[name] : undefined);
	      return Number.isFinite(v) ? v : fallback;
	    }
	    function bindTag(sel) {
	      const el = document.querySelector(sel);
	      if (!el) return;
	      const start = _numAttr(el, "start", 0);
	      const dur = _numAttr(el, "duration", 0);
	      if (!(dur > 0)) {
	        tl.set(sel, { opacity: 0 }, 0);
	        return;
	      }
	      tl.fromTo(sel, { opacity: 0, x: -40 }, { opacity: 1, x: 0, duration: 0.4, ease: "back.out(1.6)" }, start);
	      tl.to(sel, { opacity: 0, x: -40, duration: 0.3, ease: "power2.in" }, Math.max(start, start + dur - 0.3));
	      tl.set(sel, { opacity: 0 }, start + dur);
	    }
	    bindTag("#tag-morning");
	    bindTag("#tag-story1");
	    bindTag("#tag-story2");
	    bindTag("#tag-story3");

	    const openerEl = document.querySelector("#opener-poster");
	    if (openerEl && openerEl.style.display !== "none") {
	      tl.set("#opener-poster", { xPercent: -50, yPercent: -50, scale: 0.92 }, 0);
	      tl.fromTo(
	        "#opener-poster",
	        { opacity: 0 },
		        {
		          opacity: 1,
		          scale: 1.0,
		          duration: 0.4,
		          ease: "power3.out",
		          overwrite: "auto",
		        },
	        0.5
	      );
	      tl.to(
	        "#opener-poster",
		        { opacity: 0, duration: 0.4, ease: "power2.in", overwrite: "auto" },
	        0.5 + {{OPENER_DURATION_FLOAT}} - 0.4
	      );
	    }

	    /* === Climax glitch (schedule from clip data attrs) === */
		    tl.set("#climax-glitch",   { xPercent: -50, yPercent: 0 }, 0);
		    tl.set("#climax-glitch-r", { xPercent: -50, yPercent: 0 }, 0);
		    tl.set("#climax-glitch-c", { xPercent: -50, yPercent: 0 }, 0);
	    const climaxEl = document.querySelector("#climax-glitch");
	    const climaxStart = _numAttr(climaxEl, "start", 0);
	    const climaxDur = _numAttr(climaxEl, "duration", 0);
	    if (climaxDur > 0) {
		      tl.fromTo(
		        "#climax-glitch",
		        { opacity: 0, scale: 0.9 },
		        {
		          opacity: 1,
		          scale: 1.0,
		          duration: 0.3,
		          ease: "power2.out",
		          overwrite: "auto",
		        },
		        climaxStart
		      );
		      tl.fromTo(
		        "#climax-glitch-r",
		        { x: -50, opacity: 0 },
		        { x: -12, opacity: 0.85, duration: 0.08, overwrite: "auto" },
		        climaxStart + 0.20
		      );
		      tl.fromTo(
		        "#climax-glitch-c",
		        { x: 50, opacity: 0 },
		        { x: 12, opacity: 0.85, duration: 0.08, overwrite: "auto" },
		        climaxStart + 0.20
		      );
		      tl.to(
		        "#climax-glitch-r",
		        { x: -4, duration: 0.32, ease: "power3.out", overwrite: "auto" },
		        climaxStart + 0.30
		      );
		      tl.to(
		        "#climax-glitch-c",
		        { x: 4, duration: 0.32, ease: "power3.out", overwrite: "auto" },
		        climaxStart + 0.30
		      );
	      tl.to("#climax-glitch", { scale: 1.04, duration: 0.20, yoyo: true, repeat: 1 }, climaxStart + Math.max(0.2, climaxDur * 0.55));
		      tl.to(
		        ["#climax-glitch", "#climax-glitch-r", "#climax-glitch-c"],
		        { opacity: 0, duration: 0.4, ease: "power2.in", overwrite: "auto" },
		        Math.max(climaxStart, climaxStart + climaxDur - 0.25)
		      );
	    }

	    /* === End card (schedule from clip data attrs) === */
	    const endEl = document.querySelector("#end-card");
	    const endStart = _numAttr(endEl, "start", 0);
	    const endDur = _numAttr(endEl, "duration", 0);
	    if (endDur > 0) {
	      tl.to("#end-card", { opacity: 1, duration: 0.4, ease: "power2.out" }, endStart);
	      tl.from(".end-card .show",    { y: 22, opacity: 0, duration: 0.4, ease: "power3.out" }, endStart + 0.10);
	      tl.from(".end-card .tagline", { y: 14, opacity: 0, duration: 0.4, ease: "power2.out" }, endStart + 0.40);
	      tl.from(".end-card .source",  { opacity: 0, duration: 0.4, ease: "power2.out" }, endStart + 0.70);
	    }

    window.__timelines["main"] = tl;
  </script>
</body>
</html>
